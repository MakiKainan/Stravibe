#!/usr/bin/env node
// Hook recorder: one JSON line per event, empty stdout, always exit 0.
// Prompt text is classified in memory and never written.
const fs = require('fs');
const path = require('path');

const CORRECTIONS = [
  /^\s*no\b/i,
  /\b(wrong|still broken|still failing|doesn'?t work|not working|revert|undo|that'?s not)\b/i,
  /\b(salah|masih error|masih rusak|ga jalan|gak jalan|nggak jalan|bukan itu|balikin)\b/i,
];
const CAPS_MIN_LETTERS = 10;
const CAPS_MIN_SHARE = 0.6;
const OWN = /^\s*\/(stravibe:)?activity\b/;
const SELF = /^\s*<[a-z]+(-[a-z]+)+>/; // e.g. <task-notification>

function classify(prompt) {
  const letters = prompt.match(/\p{L}/gu) || [];
  const upper = letters.filter((c) => c !== c.toLowerCase()).length;
  return {
    len: prompt.length,
    corr: CORRECTIONS.some((re) => re.test(prompt)),
    caps: letters.length >= CAPS_MIN_LETTERS && upper / letters.length >= CAPS_MIN_SHARE,
    own: OWN.test(prompt),
  };
}

function toEvent(p, now) {
  const e = { t: now.toISOString(), ev: p.hook_event_name, sid: p.session_id, cwd: p.cwd, tp: p.transcript_path };
  if (e.ev === 'UserPromptSubmit') {
    const prompt = String(p.prompt ?? '');
    Object.assign(e, classify(prompt), { self: SELF.test(prompt) });
  }
  if (e.ev === 'SessionStart' && p.model) e.model = p.model;
  if (e.ev === 'StopFailure') e.reason = p.error ?? p.reason;
  if (e.ev === 'PostCompact') e.trigger = p.trigger;
  return e;
}

function main() {
  let input = '';
  process.stdin.on('data', (d) => (input += d));
  process.stdin.on('end', () => {
    try {
      const dir = process.env.CLAUDE_PLUGIN_DATA;
      fs.mkdirSync(dir, { recursive: true });
      fs.appendFileSync(path.join(dir, 'events.jsonl'), JSON.stringify(toEvent(JSON.parse(input), new Date())) + '\n');
    } catch (err) {
      process.stderr.write(`stravibe-record: ${err.message}\n`);
    }
  });
}

module.exports = { classify, toEvent };
if (require.main === module) main();
